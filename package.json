{
  "name": "@popp0102/nova",
  "private": false,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts public",
    "build": "tsc -b config/tsconfig.json && vite build --config config/vite.config.ts",
    "lint": "eslint .",
    "preview": "vite preview --config config/vite.config.ts",
    "prepublishOnly": "npm run build",
    "tests": "jest --config config/jest.config.ts",
    "coverage": "jest --config config/jest.config.ts --coverage --collectCoverageFrom='lib/**/*.{ts,tsx,js,jsx}'"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@jest/globals": "^30.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "vite-plugin-libcss": "^1.1.2"
  },
  "peer_dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "main": "dist/nova.js",
  "files": [
    "dist"
  ]
}